# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here          # ⚠️ 必填
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# 引战检测 AI（可选；留空则回退用 DeepSeek 的 key/网址/模型检测引战）
# 可填其他 OpenAI 兼容的内容安全模型
TOXIC_API_KEY=
TOXIC_API_URL=
TOXIC_MODEL=

# 视觉识图（花璃看图/表情包；可选，留空回退用 DeepSeek key/网址）
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_API_URL=
VISION_API_KEY=
VISION_TIMEOUT=30
# 是否识别合并转发（聊天记录）里的图片（默认false，省视觉token；想开改true）
VISION_FORWARD_IMAGES=false

# 稳定性
# 单条消息处理超时（秒）：超过视为卡死跳过，防止一条慢消息堵住整个群
EVENT_PROCESS_TIMEOUT=90
# 同时处理消息的并发上限（AI/识图都吃这个额度）
MAX_CONCURRENT_AI=3
# 上下文崩溃持久化：周期备份最近50条，意外去世后重启自动恢复
CONTEXT_BACKUP_PATH=./data/context_backup.json
CONTEXT_BACKUP_INTERVAL=60

# Bot 基础信息
BOT_QQ=114514                               # ⚠️ 必填
BOT_NICKNAME=花璃

# 连接配置
WS_HOST=127.0.0.1
WS_PORT=3001
HTTP_API_BASE=http://127.0.0.1:3000

# 行为策略
ONLY_REPLY_WHEN_AT=false
USER_COOLDOWN=5
BOT_COOLDOWN=2
MAX_REPLY_LENGTH=40
MAX_CONSECUTIVE_REPLIES=3
CONTEXT_SIZE=300
LOG_LEVEL=INFO

# 随机主动聊天
NIGHT_SILENCE_START=0
NIGHT_SILENCE_END=8
ACTIVE_CHAT_COOLDOWN=180
BOT_CONSECUTIVE_REPLY_COOLDOWN=60

# 复读
REPEAT_WINDOW=120
REPEAT_THRESHOLD=3

# 引战冷却
TOXIC_WARNING_COOLDOWN=900

# 戳戳回复开关
POKE_REPLY_ENABLED=true

# 记忆库路径
MEMORY_PATH=./data/memory.json

# 消息存档路径
ARCHIVE_BASE_DIR=./data/archive

# ========================================
# 【群聊白名单控制】
# 留空（= 后面什么都不填）→ 允许所有群 + 主动聊天自动选活跃群
# 填 [群号1, 群号2] → 仅限这些群
# ========================================
ALLOWED_GROUP_IDS=

# ========================================
# 【引战检测控制】
# [] = 不检测任何群
# [群号] = 仅在该群检测
# ========================================
TOXIC_GROUP_IDS=[]