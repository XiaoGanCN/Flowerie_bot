# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here          # ⚠️ 必填
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# Bot 基础信息
BOT_QQ=114514                               # ⚠️ 必填
BOT_NICKNAME=花璃

# 连接配置
WS_HOST=127.0.0.1
WS_PORT=3001
HTTP_API_BASE=http://127.0.0.1:3000

# 行为策略
ONLY_REPLY_WHEN_AT=false
REPLY_PROBABILITY=0.3
ACTIVE_CHAT_INTERVAL=600
USER_COOLDOWN=5
BOT_COOLDOWN=2
MAX_REPLY_LENGTH=40
MAX_CONSECUTIVE_REPLIES=3
CONTEXT_SIZE=300
COLD_TIME=600
LOG_LEVEL=INFO

# 随机主动聊天
RANDOM_ACTIVE_CHAT_MIN_INTERVAL=14400
RANDOM_ACTIVE_CHAT_MAX_INTERVAL=21600
NIGHT_SILENCE_START=0
NIGHT_SILENCE_END=8
ACTIVE_CHAT_COOLDOWN=180
BOT_CONSECUTIVE_REPLY_COOLDOWN=60
BOT_RECENT_REPLY_WINDOW=60

# 复读
REPEAT_WINDOW=120
REPEAT_THRESHOLD=3

# 引战冷却
TOXIC_WARNING_COOLDOWN=900

# 戳戳回复开关
POKE_REPLY_ENABLED=true

# 记忆库路径
MEMORY_PATH=./data/memory.json

# 消息存档路径
ARCHIVE_BASE_DIR=./data/archive

# ========================================
# 【群聊白名单控制】
# 留空（= 后面什么都不填）→ 允许所有群 + 主动聊天自动选活跃群
# 填 [群号1, 群号2] → 仅限这些群
# ========================================
ALLOWED_GROUP_IDS=

# ========================================
# 【引战检测控制】
# [] = 不检测任何群
# [群号] = 仅在该群检测
# ========================================
TOXIC_GROUP_IDS=[]
