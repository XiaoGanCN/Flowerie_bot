{
  "id": "sdk_plugin",
  "name": "SDK Demo Plugin",
  "version": "1.0.0",
  "description": "SDK 模式最小示例：@command 匹配 + event.reply",
  "runtime": "python",
  "entry": "plugin.py",
  "api_version": "1",
  "permissions": [
    "read_message",
    "send_message",
    "read_message_history",
    "read_group_info",
    "read_memory",
    "write_memory",
    "http_request",
    "filesystem_read",
    "filesystem_write",
    "delete_message",
    "group_manage",
    "request_handle",
    "scheduler",
    "storage",
    "ai_chat"
  ]
}